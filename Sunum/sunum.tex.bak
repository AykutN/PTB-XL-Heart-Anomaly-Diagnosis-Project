%=================================
\section{Giriş}

\begin{frame}{Giriş}
    \begin{itemize}
        \item Elektrokardiyografi (EKG), kalp hastalıklarının erken ve doğru tanısında kritik öneme sahiptir.
        \item EKG morfolojisi (dalga süre/genlikleri, eksenler, segmentler) ritim/iletim/miyokard patolojilerinin tespitinde kullanılır.
        \item Makine öğrenmesi tabanlı karar destek sistemleri, klinik pratikte hekimlere yardımcı araçlar olarak yaygınlaşmaktadır.
    \end{itemize}
\end{frame}

\begin{frame}{Çalışmanın Amacı}
    \begin{itemize}
        \item PTB-XL+ veri setinden çıkarılmış EKG öznitelikleri ile 5 üst sınıfı sınıflandırmak:
        \begin{itemize}
            \item NORM, MI, STTC, CD, HYP
        \end{itemize}
        \item Sınıf dengesizliği için iki yaklaşımı karşılaştırmak:
        \begin{itemize}
            \item Sınıf ağırlıkları (\texttt{class\_weight="balanced"})
            \item Yalnızca eğitim setinde undersampling
        \end{itemize}
        \item Açıklanabilir (feature importance) bir RF hattı tasarlayıp değerlendirmek.
    \end{itemize}
\end{frame}

%=================================
\section{Literatür Taraması}

\begin{frame}{Literatürden Örnek Çalışma 1}
    \textbf{[1]} PTB-XL ve Georgia ECG veri setlerinde LVH tespiti:
    \begin{itemize}
        \item Yalnızca NORMAL ve LVH etiketli kayıtlar; düşük kaliteli sinyaller elenmiştir.
        \item Logistic Regresyon, RF ve SVM denenmiş; RF ve SVM ile \%87+ duyarlılık/özgüllük raporlanmıştır.
        \item Dengesizlik: normal sınıfta downsampling + çoklu tekrar/ensemble.
        \item SFFS ile en önemli 5 özellik seçilerek basitleştirilmiş modeller kurulmuştur.
    \end{itemize}
\end{frame}

\begin{frame}{Literatürden Örnek Çalışma 2}
    \textbf{[2]} MI tespiti için klasik ML ve CNN karşılaştırması:
    \begin{itemize}
        \item KNN, SVM, RF, XGBoost, Decision Tree, Gaussian NB vb. klasik modeller denenmiştir.
        \item Eksik verilerde \texttt{SimpleImputer}, ağaç dışı modellerde \texttt{StandardScaler} kullanılmıştır.
        \item PTB-XL'den yalnızca NORM ve MI etiketli kayıtlarla çalışılmıştır.
        \item En yüksek doğruluk: XGBoost ile \%89; ardından SVM ve RF \%88 civarı.
    \end{itemize}
\end{frame}

\begin{frame}{Literatürden Örnek Çalışma 3}
    \textbf{[4]} PhysioNet/CinC 2020 Challenge: öznitelikler + XGBoost:
    \begin{itemize}
        \item Çoklu etiket için her etiket adına ayrı ikili XGBoost modeli eğitilmiştir.
        \item Dengesizlik: undersampling + K-fold ile ele alınmıştır.
        \item Karar için sınıf bazlı yüksek eşikler (ör. 0.9) kullanılmıştır.
    \end{itemize}
\end{frame}

%=================================
\section{Yöntem}

\subsection{Veri Seti}

\begin{frame}{PTB-XL+ Veri Seti}
    \begin{itemize}
        \item PTB-XL+: 12 derivasyon EKG dalga formlarından (12SL, Uni-G, ECGDeli) çıkarılmış klinik yorumlanabilir öznitelikler içerir.
        \item Süre, genlik, eksen, segment başlangıç/bitiş, alan ve (Uni-G) vektörkardiyografik ölçümler mevcuttur.
        \item Etiketler SCP-ECG üzerinden 5 üst sınıfa dönüştürülmüştür (NORM/MI/STTC/CD/HYP).
    \end{itemize}
\end{frame}

\begin{frame}{PTB-XL Demografik ve Tanısal Özellikler}
    \begin{itemize}
        \item 18.869 hastadan, 10 saniyelik 21.799 klinik 12 derivasyonlu EKG kaydı (500 ve 100 Hz sürümleri mevcut).
        \item Yaş dağılımı 40--80 yaşta yoğun, ortalama 62.8 yıl; ortalama boy 166.7 cm, kilo 71.0 kg.
        \item Cinsiyet: %52.1 erkek, %47.9 kadın.
        \item Veri çerçevesi: 21.388 kayıt, 793 sütun (750 sayısal, 42 tamsayı, 1 kategorik).
    \end{itemize}
\end{frame}

\begin{frame}{Figür 1: Veri Seti Genel Görünüm}
    \centering
    \resizebox{0.95\linewidth}{!}{\includegraphics{dataset_overview.png}}
\end{frame}

\begin{frame}{Sınıf Dağılımları ve Dengesizlik}
    \begin{itemize}
        \item Üst sınıflar: NORM, MI, STTC, CD, HYP.
        \item Yaklaşık dağılım:
        \begin{itemize}
            \item NORM: \%44.5, MI: \%25.4, STTC: \%13.2, CD: \%10.9, HYP: \%6.1
        \end{itemize}
        \item Belirgin dengesizlik: çoğunluk NORM; azınlık HYP.
        \item Bu durum, azınlık sınıflarda recall/F1 düşüşüne ve accuracy'nin yanıltıcı şişmesine yol açabilir.
    \end{itemize}
\end{frame}

\subsection{Ön İşleme}

\begin{frame}{Ön İşleme: Genel Hatlar}
    \begin{itemize}
        \item Klinik metadata + 12-lead öznitelikler \texttt{ecg\_id} ile birleştirildi.
        \item Etiketi olmayan / üst sınıfa düşmeyen 411 kayıt çıkarıldı; 21.388 kayıt kaldı.
        \item Veri sızıntısını önlemek için tüm fit işlemleri (imputer/scaler/feature selection) split \emph{sonrası} ve sadece eğitim setinde yapıldı.
    \end{itemize}
\end{frame}

\begin{frame}{Eksik Veriler: Demografi ve EKG}
    \begin{itemize}
        \item Demografi:
        \begin{itemize}
            \item Boy: \%67.65, kilo: \%56.21 eksik $\rightarrow$ modelden çıkarıldı.
        \end{itemize}
        \item EKG öznitelikleri:
        \begin{itemize}
            \item \texttt{T\_AxisFront\_Global} ve \texttt{R\_AxisFrontal\_Global}: çok az eksik $\rightarrow$ ilgili kayıtlar silindi.
            \item P dalgası ilişkili değişkenler (örn. \texttt{P\_On\_Global}, \texttt{P\_Dur\_Global}, \texttt{PR\_Int\_Global}, \texttt{HR\_Atrial\_Global}): yaklaşık \%8 eksik.
        \end{itemize}
        \item P-dalgası eksikliği bazı ritim bozukluklarını işaret edebileceği için ``bilgi taşıyan eksiklik'' olarak ele alındı.
    \end{itemize}
\end{frame}

\begin{frame}{Figür 2: Eksik Değer Analizi}
    \centering
    \resizebox{0.95\linewidth}{!}{\includegraphics{missing_values_analysis.png}}
\end{frame}

\begin{frame}{Eksik Veri Stratejisi}
    \begin{itemize}
        \item P-dalgası ilişkili özniteliklerde: sabit değer (0.0) + \texttt{is\_missing} bayrağı.
        \item Diğer sayısal özniteliklerde: eğitim seti medyanı + \texttt{is\_missing} bayrağı.
        \item \texttt{heart\_axis}: \%38 eksiklik + düşük ek bilgi $\rightarrow$ çıkarıldı.
    \end{itemize}
\end{frame}

\begin{frame}{Veri Bölme, İmputasyon ve Ölçekleme}
    \begin{itemize}
        \item Veri \texttt{strat\_fold} ile bölündü:
        \begin{itemize}
            \item Eğitim: 17.084 (\%79.9)
            \item Doğrulama: 2.146 (\%10.0)
            \item Test: 2.158 (\%10.1)
        \end{itemize}
        \item \texttt{SimpleImputer(strategy="median")} ve \texttt{StandardScaler} sadece eğitim setinde fit edildi; val/test'e aynı dönüşümler uygulandı.
        \item Eksiklik bayrakları ölçekleme dışında bırakıldı.
    \end{itemize}
\end{frame}

\begin{frame}{Figür 3: Splitlere Göre Sınıf Dağılımı}
    \centering
    \resizebox{0.98\linewidth}{!}{\includegraphics{class_distribution_splits.png}}
\end{frame}

\begin{frame}{Sınıf Dengesizliği: Denenen Yaklaşımlar}
    \begin{itemize}
        \item Sınıf ağırlıkları: kayıp fonksiyonunda azınlık sınıfların etkisini artırır (\texttt{balanced}).
        \item Undersampling: yalnızca eğitim setinde çoğunluk sınıfı azaltılır; val/test doğal dağılımı korur.
    \end{itemize}
\end{frame}

\subsection{Öznitelik Seçimi}

\begin{frame}{Öznitelik Seçimi (Özet)}
    \begin{itemize}
        \item Varyans eşikleme: 0.05 altında kalan 186 öznitelik elendi.
        \item Random Forest önem skorları ile Top-50 / Top-100 / Top-200 alt kümeleri oluşturuldu.
    \end{itemize}
\end{frame}

\begin{frame}{Figür 4: Öznitelik Seçimi Özeti}
    \centering
    \resizebox{0.95\linewidth}{!}{\includegraphics{feature_selection_analysis.png}}
\end{frame}

\subsection{Model Seçimi ve Eğitim}

\begin{frame}{Model: Random Forest}
    \begin{itemize}
        \item Tek sınıflandırıcı: Random Forest (RF).
        \item Neden RF?
        \begin{itemize}
            \item Nonlineer ilişkileri yakalar, yüksek boyutta güçlüdür,
            \item Öznitelik önemleriyle açıklanabilirlik sağlar,
            \item Ölçeklemeye görece duyarsızdır.
        \end{itemize}
        \item Sabit hiperparametreler:
        \begin{itemize}
            \item \texttt{n\_estimators=250}, \texttt{max\_depth=12}, \texttt{random\_state=42}, \texttt{n\_jobs=-1}
        \end{itemize}
    \end{itemize}
\end{frame}

\begin{frame}{Deney Tasarımı}
    \begin{itemize}
        \item Değişkenler:
        \begin{itemize}
            \item Öznitelik sayısı: Top-50 / Top-100 / Top-200
            \item Dengesizlik stratejisi: class weight vs undersampling
        \end{itemize}
        \item Senaryolar:
        \begin{itemize}
            \item \textbf{CW-50 / CW-100 / CW-200}: \texttt{class\_weight="balanced"}
            \item \textbf{US-200}: eğitim setinde random undersampling + Top-200
        \end{itemize}
        \item Sınıf bazlı karar eşikleri: F1'i maksimize edecek şekilde 0.01 aralıklarla tarandı.
    \end{itemize}
\end{frame}

%=================================
\section{Sonuçlar}

\begin{frame}{Genel Performans (Eğitim / Val)}
    \begin{itemize}
        \item RF + Top-50: Accuracy \%55.33, Precision \%67.64, Recall \%76.53, F1 \%71.53, ROC-AUC 0.904.
        \item RF + Top-100: Accuracy \%58.43, Precision \%71.29, Recall \%73.68, F1 \%72.39, ROC-AUC 0.909.
        \item RF + Top-200: Accuracy \%58.85, Precision \%71.30, Recall \%75.60, F1 \%73.21, ROC-AUC 0.915.
        \item Top-200 + Ensemble/US: Recall artarken precision/accuracy düşmüş; toplam F1 kazancı sınırlı kalmıştır.
    \end{itemize}
\end{frame}

\begin{frame}{Sınıf Bazlı Sonuçlar (CW-200)}
    \begin{itemize}
        \item NORM: eşik 0.30; Precision \%79.27, Recall \%92.11, F1 \%85.21.
        \item MI: eşik 0.45; Precision \%74.91, Recall \%72.73, F1 \%73.80.
        \item STTC: eşik 0.46; Precision \%69.24, Recall \%79.08, F1 \%73.84.
        \item CD: eşik 0.45; Precision \%76.87, Recall \%70.36, F1 \%73.47.
        \item HYP: eşik 0.43; Precision \%56.23, Recall \%63.74, F1 daha düşüktür (en zor sınıf).
    \end{itemize}
\end{frame}

\begin{frame}{ROC-AUC Değerleri (CW-200)}
    \begin{itemize}
        \item NORM: 0.938, MI: 0.923, STTC: 0.929, CD: 0.901, HYP: 0.883
        \item HYP ayrımı görece daha zor; buna rağmen tüm sınıflarda AUC 0.88+.
    \end{itemize}
\end{frame}

\begin{frame}{Figür 5: ROC Eğrileri (RF - Top-200)}
    \centering
    \resizebox{0.95\linewidth}{!}{\includegraphics{roc_curves_RandomForest_top200.png}}
\end{frame}

%=================================
\section{Tartışma ve Gelecek Çalışmalar}

\begin{frame}{Tartışma (Özet)}
    \begin{itemize}
        \item PTB-XL+ üzerinde 5 üst sınıf için RF tabanlı bir hat kurulmuştur.
        \item P-dalgası eksikliği ``teknik eksik'' değil, potansiyel klinik işaret olarak ele alınmış ve bayraklarla modele taşınmıştır.
        \item Öznitelik sayısı arttıkça performans genel olarak artmıştır (Top-200 en iyi).
        \item Undersampling recall'ı artırsa da precision/accuracy'de düşüş oluşturmuştur; class weight daha dengeli davranmıştır.
    \end{itemize}
\end{frame}

\begin{frame}{Sınırlılıklar ve Gelecek Çalışmalar}
    \begin{itemize}
        \item Dengesizlik yalnızca class weight ve basit undersampling ile ele alındı.
        \item Olasılık kalibrasyonu ve klinik hedefe göre eşik optimizasyonu ayrıca incelenebilir.
        \item Gelecek:
        \begin{itemize}
            \item XGBoost/LightGBM ile karşılaştırma,
            \item Balanced RF / EasyEnsemble gibi dengesizlik odaklı yöntemler,
            \item HYP için alt sınıf düzeyi (LVH/RVH) ve ek klinik öznitelikler.
        \end{itemize}
    \end{itemize}
\end{frame}

